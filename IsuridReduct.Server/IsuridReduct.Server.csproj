<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\isuridreduct.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:64341</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>9.*-*</Version>
    </PackageReference>
  </ItemGroup>

  <!-- The esproj is a JavaScript project that Visual Studio builds via its JS project
       system. When building with the CLI (e.g. in Docker), SkipSpaBuild=true excludes
       it so MSBuild does not try to run .NET language targets (CoreCompile, etc.) on it.
       The React bundle is built separately and copied into wwwroot in that case. -->
  <ItemGroup Condition="'$(SkipSpaBuild)' != 'true'">
    <ProjectReference Include="..\isuridreduct.client\isuridreduct.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

</Project>
